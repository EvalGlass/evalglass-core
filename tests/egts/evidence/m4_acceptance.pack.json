  "claims": [
    {
      "id": "calibrated-approved-judge-gates",
      "text": "A calibrated judge with a complete host-owned approved threshold gates through the single Verdict Engine and passes because the judge score clears the approved threshold.",
      "risk_surfaces": [
        "verdict",
        "authority"
      ],
      "expected_families": [
        "authority_verdict"
      ],
      "required_artifacts": [
        "m4-sc-calibrated",
        "m4-cal-record",
        "m4-threshold",
        "m4-judge-score"
      ]
    },
    {
      "id": "uncalibrated-judge-cannot-gate",
      "text": "An uncalibrated judge metric cannot gate: it stays informational and does not fail CI.",
      "risk_surfaces": [
        "authority"
      ],
      "expected_families": [
        "authority_verdict"
      ],
      "required_artifacts": [
        "m4-sc-uncal"
      ]
    },
    {
      "id": "drifted-judge-blocks-not-silent-pass",
      "text": "A drifted judge metric does not silently pass: it blocks the run rather than scoring, surfacing the loss of calibration.",
      "risk_surfaces": [
        "authority"
      ],
      "expected_families": [
        "authority_verdict"
      ],
      "required_artifacts": [
        "m4-sc-drifted"
      ]
    },
    {
      "id": "required-tier-hermetic-and-lane-deletable",
      "text": "The required tier (core + harness + adapters, excluding the optional judge_live lane) imports no provider SDK and reaches no hidden input; the live judge lane is opt-in, not a required dependency, and deletable.",
      "risk_surfaces": [
        "integration",
        "hermetic"
      ],
      "expected_families": [
        "integration_boundary"
      ],
      "required_artifacts": [
        "m4-hermetic",
        "m4-lane"
      ]
    }
  ],
